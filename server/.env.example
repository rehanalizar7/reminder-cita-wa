# Salin file ini jadi .env lalu isi sesuai environment kamu.

# --- Server ---
PORT=4000
# Ganti dengan string acak yang panjang (buat sign JWT session dashboard)
JWT_SECRET=ganti-dengan-random-string-panjang
# Base URL tempat dashboard/web di-deploy (buat CORS + redirect OAuth)
WEB_BASE_URL=http://localhost:5173
SERVER_BASE_URL=http://localhost:4000

# --- Database (SQLite, file lokal di server) ---
DATABASE_URL="file:./data/reminder-cita.db"

# --- Google OAuth (dipakai untuk login REE sekaligus ambil kontak People API) ---
# Bikin di https://console.cloud.google.com/apis/credentials
# 1. Buat OAuth Client ID tipe "Web application"
# 2. Authorized redirect URI: {SERVER_BASE_URL}/auth/google/callback
# 3. Enable "People API" di API Library
GOOGLE_CLIENT_ID=xxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxxxx
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback

# Kalau mau batasi login cuma untuk domain kantor tertentu, isi ini (opsional)
# ALLOWED_EMAIL_DOMAIN=sampoerna.com

# --- WhatsApp (Baileys) ---
# Folder tempat auth session tiap REE disimpan (jangan di-commit ke git!)
WA_SESSIONS_DIR=./data/wa-sessions
# Jeda minimum & maksimum (ms) antar pesan per sesi REE, biar gak diblokir WA
WA_MIN_DELAY_MS=4000
WA_MAX_DELAY_MS=12000
# Batas maksimum pesan terkirim per REE per hari (WIB), safety valve anti-banned.
# Kalau tercapai, sisa antrian ditahan dan otomatis lanjut besok — gak hilang.
# Set 0 buat mematikan batas ini (tidak disarankan, apalagi untuk nomor baru).
WA_DAILY_LIMIT=120
